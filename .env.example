# Copy to .env.local, fill from Supabase project settings + password manager.
# Never commit .env.local. See LEAD-CRM-Spec-v1.0.md Section 2.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment proof files (Spec 9.12, 14). Private bucket, no public access —
# Shawn creates it per environment. The provider lives behind
# lib/uploads/signer.ts, so proof_file_key stays an opaque key.
PAYMENT_PROOF_BUCKET=payment-proofs

DATABASE_URL=
AUTH_SECRET=
APP_BASE_URL=http://localhost:3000

# Dev only — both ignored when NODE_ENV=production.
# Your login's role comes from app_user (npm run db:seed links it as super_admin).
# DEV_ROLE overrides that role, to test what another role sees:
#   super_admin | management | marketing | sales | support | operations | part_time
DEV_ROLE=
# DEV_USER_ID acts as another app_user. Seeded staff (scripts/seed-ids.ts):
#   Wei Ping (sales)      00000000-0000-4000-8000-000000000001
#   Daphne (marketing)    00000000-0000-4000-8000-000000000002
#   Lee Yee (part_time)   00000000-0000-4000-8000-000000000003
DEV_USER_ID=

# Public API (Spec 8, lib/public/) — live since 16 Oct. Every one of these
# fails CLOSED when it is unset: the route answers an error or drops a feature,
# it never warns. Set all of them in every environment, Netlify included.

# The key the website sends as X-Api-Key. May hold several keys separated by
# commas so one can be rotated without a gap. A key shorter than 16 characters
# is ignored, so a too-short value reads as unset: GET /api/public/schedule and
# POST /api/public/leads then answer 503 not_configured.
PUBLIC_API_KEY=
# Server-only HMAC key for the public API's per-IP rate limit (at least 16
# characters; never the same as PUBLIC_API_KEY, which browsers hold). Unset =
# POST /api/public/leads answers 503.
RATE_LIMIT_SECRET=
# Browser origins allowed to call the public API, comma separated. https only
# (http allowed for localhost), no wildcard, anything unparseable is dropped.
# Unset = every browser request carrying an Origin is 403 origin_not_allowed.
# A server-side call sends no Origin and is unaffected.
PUBLIC_ALLOWED_ORIGINS=http://localhost:3000
# Public site root, used to build each class's registerUrl in the schedule feed
# (Spec 8.1). Unset = every registerUrl is null and no class gets a Register
# link on the website (Spec 10.1).
PUBLIC_WEBSITE_URL=http://localhost:3000
# CAPTCHA on the public forms (Spec 10.3). With no provider key every
# submission is refused as a bad token. PUBLIC_CAPTCHA_DISABLED=true skips the
# check for local development and is ignored when NODE_ENV=production.
TURNSTILE_SECRET_KEY=
PUBLIC_CAPTCHA_DISABLED=true

# Filled in later sprints (Shawn's side) — placeholders only for now:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WATI_API_BASE=
WATI_TOKEN=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
ESP_API_KEY=
SENTRY_DSN=
